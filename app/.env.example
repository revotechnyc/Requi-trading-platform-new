# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
PORT=3001                 # HTTP listen port (dev + production). Live site uses 3000.

# ── Database (PostgreSQL — canonical system of record; Supabase-compatible) ──
# Production: postgres://postgres:[pwd]@db.[project].supabase.co:5432/postgres
DATABASE_URL=             # PostgreSQL connection string
# Local development (embedded Postgres socket — no DATABASE_URL needed):
PG_SOCKET_DIR=            # e.g. /home/kimi/pgdata
PG_DATABASE=requi
PG_USER=postgres

# ── Supabase Auth (production identity provider) ───────────────
# When URL + anon key are set, Supabase Auth is the identity provider:
# email/password, email verification, password reset, Google OAuth, MFA-ready.
SUPABASE_URL=             # https://[project].supabase.co
SUPABASE_ANON_KEY=        # publishable anon key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY= # server jobs only — NEVER exposed to the frontend
SUPABASE_JWT_SECRET=      # optional legacy HS256 secret; JWKS verification is preferred

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Google Sign-In (preliminary integration) ──────────────────
# Leave EMPTY until Google Cloud OAuth credentials exist — the app detects
# empty values and fails gracefully (login page notice), never crashes.
# See GOOGLE_AUTH_SETUP.md for the exact Google Cloud steps.
# Server-side only — never expose the secret to the browser or commit it to Git.
GOOGLE_CLIENT_ID=         # Google OAuth Web Application client ID
GOOGLE_CLIENT_SECRET=     # Google OAuth client secret

# ── Robinhood Agentic Trading (MCP) OAuth ─────────────────────
# Connect from live HTTPS only — Robinhood rejects localhost redirects.
PUBLIC_APP_URL=           # e.g. https://requitrading.com
ROBINHOOD_MCP_REDIRECT_URI=  # optional override: https://requitrading.com/auth/robinhood/callback
# ROBINHOOD_TOKEN_KEY=    # optional; defaults to APP_SECRET for sealing OAuth tokens
# ROBINHOOD_MCP_TOKEN=    # optional ops/env bearer (registry) — not required for per-user OAuth
